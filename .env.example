# Django runtime
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-this-with-a-50-character-random-secret-in-production
JWT_SIGNING_KEY=use-a-separate-long-random-production-signing-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL. Omit DATABASE_URL during the first local setup to use SQLite.
DATABASE_URL=postgresql://taskcraft:change-this-local-password@localhost:5432/taskcraft

# Redis backs Channels and Celery in development and production.
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CHANNEL_LAYER=False

# Set for cross-origin frontend deployments.
CORS_ALLOWED_ORIGINS=http://localhost:5173
MAX_ATTACHMENT_SIZE_BYTES=10485760

# Stripe billing (leave empty until Stripe products and webhook are configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
SENTRY_DSN=

# Private S3-compatible attachment storage (AWS S3 or Cloudflare R2)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Transactional email SMTP (SendGrid, SES, Mailgun, etc.)
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
